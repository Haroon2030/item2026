# ——— إنتاج (nginx خارجي → :8084 → Gunicorn) ———
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=item.alrsheed.net,72.61.107.230
CSRF_TRUSTED_ORIGINS=https://item.alrsheed.net,http://item.alrsheed.net,http://72.61.107.230:8084
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
# مهم: إن فتحت الموقع بـ http وليس https مع SESSION_COOKIE_SECURE=True
# المتصفح لن يرسل كوكي الجلسة فيبدو أن الجلسة «انقطعت»
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=True
USE_SECURE_PROXY_SSL_HEADER=True

# إصدار الواجهة يُولَّد تلقائياً عند كل رفع. ثبّت الرقم فقط إذا لزم:
# APP_CLIENT_VERSION_LOCK=1
# APP_CLIENT_VERSION=2026.08.15.02

# ——— حساب الدخول إلى التطبيق ———
# حساب الدخول الأساسي — تغيير كلمة السر هنا يعيد ضبطها عند النشر
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=256400

# ——— MySQL/MariaDB (Dokploy Internal Credentials) ———
# اترك DB_HOST فارغاً محلياً لاستخدام SQLite
DB_HOST=item2026-s1zabk
DB_PORT=3306
DB_NAME=item
DB_USER=item_2026
DB_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=60

# قرص دائم للكاش (Docker: /app/data) — شهور المجموعات لا تُمسَح مع كل نشر
DATA_DIR=/app/data
# DJANGO_CACHE_TIMEOUT=604800

SYNC_SECRET=change-me-sync-secret
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_10_MINUTES=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=120
SEARCH_QUERY_MAX_LEN=128
ONYX_BASE_URL=http://SkyR.drayddns.com:8090/Service/OnyxService.svc
ONYX_ALLOWED_HOSTS=SkyR.drayddns.com
ONYX_DEFAULT_WAREHOUSE=60
# مخازن مقارنة السعر/التكلفة في بحث الأصناف (مفصولة بفاصلة)
ONYX_COMPARE_WAREHOUSES=1201,1,30,1901,2001,1801,60,701
ONYX_YEAR=2026
ONYX_TIMEOUT=60
ONYX_QTY_TIMEOUT=45
# مهلة قصيرة لمقارنة المخازن (ثوانٍ) + كاش النتيجة
ONYX_COMPARE_TIMEOUT=8
ONYX_COMPARE_CACHE_TTL=1800
ONYX_ITEMS_TIMEOUT=180

# أوراكل — قراءة فقط (SELECT). لا تُنفَّذ أوامر تعديل من التطبيق.
ORACLE_ENABLED=True
ORACLE_HOST=SkyR.drayddns.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=onyxread
ORACLE_PASSWORD=change-me
ORACLE_SCHEMA=IAS20261
# محلي Windows فقط — اتركه فارغاً على Docker/Linux
ORACLE_CLIENT_LIB_DIR=
# مهلة TCP وإعادة المحاولة عند انقطاع الشبكة المؤقت
ORACLE_TCP_CONNECT_TIMEOUT=20
ORACLE_CALL_TIMEOUT_MS=120000
ORACLE_RETRY_COUNT=3
ORACLE_RETRY_DELAY=2
ORACLE_POOL_EXPIRE_TIME=4
STOCK_QTY_SOURCE=oracle

PORT=8000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=1800
